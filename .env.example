# ==============================================================================
# Imam Ariadi Portfolio — Environment Variables Template (.env.example)
# ==============================================================================
# Salin konfigurasi di bawah ini ke Vercel Dashboard:
# Project Settings -> Environment Variables (Production & Preview)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base URL / Production Domain
# ------------------------------------------------------------------------------
# URL domain kustom resmi website portofolio (tanpa trailing slash)
NEXT_PUBLIC_SITE_URL=https://imamdev.my.id

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (PostgreSQL Database & Auth)
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Khusus Server-side Admin CMS & Server Actions)
# PERINGATAN: Jangan gunakan prefix NEXT_PUBLIC_ untuk key ini
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Database Direct & Pooled URLs (Opsional / Prisma / Migration)
# POSTGRES_URL=postgres://...
# POSTGRES_PRISMA_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...

# ------------------------------------------------------------------------------
# 3. Vercel Blob Storage (Media & Dokumen Upload)
# ------------------------------------------------------------------------------
# Dapatkan otomatis dengan menghubungkan Blob Store di tab Storage Vercel:
# Vercel Dashboard -> Storage -> Create Database / Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Opsional: URL langsung ke dokumen PDF CV jika disimpan di CDN eksternal
# NEXT_PUBLIC_CV_URL=https://...

# ------------------------------------------------------------------------------
# 4. On-Demand Cache Revalidation & Webhook Secret
# ------------------------------------------------------------------------------
# Token rahasia untuk memicu /api/revalidate
REVALIDATE_SECRET=imam_portfolio_secret_2026
